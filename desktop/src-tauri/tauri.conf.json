{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Blocklink",
  "version": "0.1.0",
  "identifier": "app.blocklink.launcher",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Blocklink",
        "width": 1240,
        "height": 820,
        "minWidth": 920,
        "minHeight": 620,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https://cdn.modrinth.com data: blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Minecraft instances, shared Mods and hosted servers",
    "category": "Game",
    "resources": [
      "notices/"
    ]
  }
}
